# Copy to .env and replace every placeholder before running `docker compose up -d`.
# .env is git-ignored. Never commit real passwords.
#
#   cp .env.example .env
#
# The SQL Server password must satisfy the SQL Server strong-password policy:
# at least 8 characters, from three of: uppercase, lowercase, digits, symbols.
#
# Do NOT use '$' in any value here. docker compose interpolates '$' in this file, so
# "pa$$word" reaches the container as "paword" while the scripts read the literal text -
# the containers and the connection strings then disagree, and the only symptom is a login
# failure. Escape it as '$$' if you really need one. The lab scripts read this file
# literally (see Read-LabEnvFile), so '=' and ';' are safe.

LAB_SQL_PASSWORD=ChangeMe_Local#2026
LAB_SQL_PORT=11433

LAB_RABBIT_USER=lab
LAB_RABBIT_PASSWORD=ChangeMe_Local#2026
LAB_RABBIT_PORT=15672
LAB_RABBIT_MANAGEMENT_PORT=15673

# Optional OTLP trace viewer (docker compose --profile tracing up -d)
LAB_OTLP_GRPC_PORT=4317
LAB_JAEGER_UI_PORT=16686
