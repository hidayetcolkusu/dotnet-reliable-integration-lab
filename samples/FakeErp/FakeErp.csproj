<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>FakeErp</RootNamespace>
    <UserSecretsId>dotnet-reliable-integration-lab-fakeerp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    FakeErp shares only repo-wide infrastructure (environment guard, telemetry setup) through
    Integration.Shared. The external-system boundary is in the DATA, not the helper code:
    separate database, no FK, no shared transaction, and its own copy of the payload contract.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Integration.Shared\Integration.Shared.csproj" />
  </ItemGroup>

</Project>
